# Ignorar directorios de build y cache
**/build/
**/target/
**/.gradle/
**/gradle/wrapper/gradle-wrapper.jar

# Ignorar archivos de configuración de IDE
**/.idea/
**/.vscode/
**/*.iml
**/*.ipr
**/*.iws
**/.project
**/.classpath
**/.settings/

# Ignorar archivos temporales y logs
**/*.log
**/*.tmp
**/*.temp
**/logs/
**/temp/

# Ignorar archivos de sistema
.DS_Store
Thumbs.db
**/.DS_Store
**/Thumbs.db

# Ignorar archivos de Git
.git/
.gitignore
**/.git/
**/.gitignore

# Ignorar documentación y archivos README
README.md
**/README.md
**/*.md
docs/
**/docs/

# Ignorar archivos de Docker (para evitar recursión)
Dockerfile*
docker-compose*.yml
.dockerignore

# Ignorar archivos de configuración local
.env
.env.local
**/.env
**/.env.local

# Ignorar archivos de testing
**/test-results/
**/coverage/
**/.nyc_output/

# Ignorar archivos específicos de Java/Gradle
**/.java-version
**/gradle.lockfile
**/gradle-wrapper.properties.backup

# Ignorar directorios de Node.js (si hay frontend)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Ignorar archivos específicos del proyecto
postgres/data/
**/postgres/data/

# Mantener archivos importantes
!gradle/wrapper/gradle-wrapper.jar
!**/src/
!build.gradle
!settings.gradle
!gradle.properties
!gradlew
!gradlew.bat